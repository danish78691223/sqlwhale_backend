PORT=5000
FRONTEND_URL=http://localhost:3000

# Separate SQLWhale MongoDB database for user accounts, sessions and learning/query data
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=sqlwhale

# Set to true only when you explicitly want MongoDB-backed query history/learning data.
MONGODB_STORE_ACTIVITY=true

# Razorpay server-side credentials (set these only in Render Environment Variables)
# Use matching Test Mode values for testing, then matching Live Mode values for production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Create a ₹49 INR monthly plan in Razorpay Dashboard > Subscriptions > Plans.
# Copy that plan's plan_... ID here (amount=4900 paise, period=monthly, interval=1).
RAZORPAY_PLAN_ID=plan_your_49_monthly_plan_id

# Configure a Razorpay webhook pointed at https://YOUR-RENDER-BACKEND/api/subscription/webhook.
# Paste the same webhook signing secret you configure in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

PORT=5000
FRONTEND_URL=http://localhost:3000

# Separate SQLWhale MongoDB database for user accounts, sessions and learning/query data
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=sqlwhale

# Set to true only when you explicitly want MongoDB-backed query history/learning data.
MONGODB_STORE_ACTIVITY=true
